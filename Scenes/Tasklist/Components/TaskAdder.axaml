<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Reviolet.Components.TaskAdder"
             Background="{DynamicResource MidgroundBrush}"
             CornerRadius="5">
  
  <Grid ColumnDefinitions="* 48" RowDefinitions="32 32" ColumnSpacing="5" RowSpacing="5" Margin="10">
    <TextBox
      x:Name="DescriptionBox"
      Classes="purpleHighlight"
      Grid.Column="0"
      Grid.Row="0"
      PlaceholderText="Enter task description..."
      VerticalContentAlignment="Center"
      TabIndex="10"
    />

    <Button
      x:Name="AdderButton"
      Grid.Column="1"
      Grid.Row="0"
      Content="{SvgImage /Assets/Icons/ic--outline-add.svg}"
      Click="AdderButton_Click"
    />

    <Grid ColumnDefinitions="* * * *" Grid.Column="0" Grid.Row="1" ColumnSpacing="5">
      <ContentControl
        Grid.Column="0"
      />

      <ContentControl
        Grid.Column="1"
      />

      <ContentControl
        Grid.Column="3"
      />

    </Grid>
  </Grid>
</UserControl>
